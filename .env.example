# Azure AI Language Service Credentials
# =======================================
# Create a free Azure AI Language resource at:
#   https://portal.azure.com → Create a resource → AI + Machine Learning → Language
#
# Then copy the endpoint and key from:
#   Azure Portal → Your Language Resource → Keys and Endpoint

AZURE_LANGUAGE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_LANGUAGE_KEY=your-api-key-here
